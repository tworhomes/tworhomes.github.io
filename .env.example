# =============================================================================
# Formspree & Web3Forms Contact Form Configuration
# =============================================================================
# Copy this file to `.env.local` for local development.
# IMPORTANT: Never commit `.env`, `.env.*`, or `.env.local` to git.
#
# Primary Asynchronous Endpoint: Formspree
# Obtain your Form ID from https://formspree.io/forms
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/<YOUR_FORM_ID>

# Optional Secondary Fallback: Web3Forms
# Obtain your Access Key from https://web3forms.com
VITE_WEB3FORMS_KEY=

